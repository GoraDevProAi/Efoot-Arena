rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isTeamMember(teamId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
    }

    function isTeamOwner(teamId) {
      return isAuthenticated() &&
        request.auth.uid == get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId;
    }

    // Users collection
    match /users/{userId} {
      // Anyone authenticated can read user profiles
      allow read: if isAuthenticated();

      // Only the user can create/update their own profile
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);

      // No one can delete user documents (use soft delete later)
      allow delete: if false;
    }

    // Teams collection
    match /teams/{teamId} {
      allow read: if isAuthenticated();

      // Any authenticated user can create a team
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      // Only owner or admins can update
      allow update: if isAuthenticated() && (
        isTeamOwner(teamId) ||
        request.auth.uid in resource.data.adminIds
      );

      // Only owner can delete
      allow delete: if isTeamOwner(teamId);
    }

    // Challenges collection
    match /challenges/{challengeId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.challengerId ||
        request.auth.uid == resource.data.opponentId
      );

      // Create challenge: must be the challenger
      allow create: if isAuthenticated()
        && request.resource.data.challengerId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Update: challenger or opponent can update status/result
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.challengerId ||
        request.auth.uid == resource.data.opponentId
      );

      allow delete: if false;
    }

    // Matches collection
    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // Rankings collection (read-only for clients)
    match /rankings/{region} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions can write rankings
    }


    // Tournaments
    match /tournaments/{tournamentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.creatorId == request.auth.uid
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // Notification queue (client writes, Cloud Function sends FCM)
    match /notification_queue/{id} {
      allow create: if isAuthenticated()
        && request.resource.data.toUserId is string
        && request.resource.data.title is string;
      allow read, update, delete: if false; // only backend
    }
  }
}

